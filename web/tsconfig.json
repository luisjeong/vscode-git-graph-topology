{
	"compilerOptions": {
		"lib": [
			"es2016",
			"dom"
		],
		"ignoreDeprecations": "6.0",
		"module": "none",
		"moduleResolution": "node",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "../media",
		"removeComments": true,
		"strict": true,
		"target": "es2016"
	}
}
